{
  "properties": {
    "displayName": "Audit MDE Entra ID Device ID on Windows Arc machines",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Checks that the MDE.Windows extension is installed and provisioned on Windows Azure Arc-enabled servers, then deploys the entraiddeviceid Azure Machine Configuration assignment to audit and report the MDE Entra ID Device ID (intuneDeviceId) from HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\SenseCM\\MemConfiguration\\EnrollmentPayload.",
    "metadata": {
      "category": "Guest Configuration",
      "version": "1.0.0",
      "requiredProviders": [
        "Microsoft.GuestConfiguration"
      ],
      "guestConfiguration": {
        "name": "entraiddeviceid",
        "contentType": "Custom",
        "contentUri": "https://github.com/seanstark/defenderforservers-tools/raw/refs/heads/main/machineConfiguration/entraid-deviceid/output/entraiddeviceid.zip",
        "contentHash": "633D583A261DA8D50AAA1B3A2FC4B7ACA049DAABAF4ECA0497C1F430922E1904",
        "version": "1.0.0"
      }
    },
    "parameters": {
      "tagName": {
        "type": "string",
        "metadata": {
          "displayName": "Optional Azure tag name",
          "description": "Name of the Azure resource tag used to filter machines. Leave blank to include all eligible Windows machines.",
          "portalReview": "true"
        },
        "defaultValue": ""
      },
      "tagValue": {
        "type": "string",
        "metadata": {
          "displayName": "Optional Azure tag value",
          "description": "Required value for the Azure resource tag. Used only when a tag name is provided.",
          "portalReview": "true"
        },
        "defaultValue": ""
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.HybridCompute/machines/extensions"
          },
          {
            "anyOf": [
              {
                "field": "name",
                "like": "*/MDE.Windows"
              },
              {
                "field": "Microsoft.HybridCompute/machines/extensions/type",
                "equals": "MDE.Windows"
              }
            ]
          },
          {
            "field": "Microsoft.HybridCompute/machines/extensions/provisioningState",
            "in": [
              "Succeeded",
              "Provisioning succeeded"
            ]
          },
          {
            "anyOf": [
              {
                "value": "[empty(parameters('tagName'))]",
                "equals": true
              },
              {
                "field": "[concat('tags[', parameters('tagName'), ']')]",
                "equals": "[parameters('tagValue')]"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "deployIfNotExists",
        "details": {
          "roleDefinitionIds": [
            "/providers/Microsoft.Authorization/roleDefinitions/088ab73d-1256-47ae-bea9-9de8e7131f31"
          ],
          "type": "Microsoft.GuestConfiguration/guestConfigurationAssignments",
          "name": "[concat('entraiddeviceid$pid', uniqueString(policy().assignmentId, policy().definitionReferenceId))]",
          "existenceCondition": {
            "field": "Microsoft.GuestConfiguration/guestConfigurationAssignments/complianceStatus",
            "equals": "Compliant"
          },
          "deployment": {
            "properties": {
              "mode": "incremental",
              "parameters": {
                "vmName": {
                  "value": "[first(split(field('name'), '/'))]"
                },
                "location": {
                  "value": "[field('location')]"
                },
                "type": {
                  "value": "Microsoft.HybridCompute/machines"
                },
                "assignmentName": {
                  "value": "[concat('entraiddeviceid$pid', uniqueString(policy().assignmentId, policy().definitionReferenceId))]"
                }
              },
              "template": {
                "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
                "contentVersion": "1.0.0.0",
                "parameters": {
                  "vmName": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "assignmentName": {
                    "type": "string"
                  }
                },
                "resources": [
                  {
                    "apiVersion": "2024-04-05",
                    "type": "Microsoft.HybridCompute/machines/providers/guestConfigurationAssignments",
                    "name": "[concat(parameters('vmName'), '/Microsoft.GuestConfiguration/', parameters('assignmentName'))]",
                    "location": "[parameters('location')]",
                    "properties": {
                      "guestConfiguration": {
                        "name": "entraiddeviceid",
                        "contentType": "Custom",
                        "contentUri": "https://github.com/seanstark/defenderforservers-tools/raw/refs/heads/main/machineConfiguration/entraid-deviceid/output/entraiddeviceid.zip",
                        "contentHash": "633D583A261DA8D50AAA1B3A2FC4B7ACA049DAABAF4ECA0497C1F430922E1904",
                        "assignmentType": "Audit",
                        "version": "1.0.0"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "name": "b23f9a45-7c28-4d83-9e61-4a02f5b3c8d7"
}
