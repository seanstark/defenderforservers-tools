[ClassVersion("1.0.0.0")]
class Reason
{
    [Read] string Code;
    [Read] string Phrase;
};

[ClassVersion("1.0.0.0"), FriendlyName("EntraIdDeviceId")]
class EntraIdDeviceId : OMI_BaseResource
{
    [Key] string Name;
    [Read] string IntuneDeviceId;
    [Read, EmbeddedInstance("Reason")] string Reasons[];
};
