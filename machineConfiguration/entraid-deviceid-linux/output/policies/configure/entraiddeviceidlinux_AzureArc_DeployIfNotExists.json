{
  "properties": {
    "displayName": "Deploy Microsoft Defender for Endpoint SenseCM intuneDeviceId on Linux Azure Arc machines (with MDE.Linux)",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "Checks that the MDE.Linux extension is installed and provisioned on Linux Azure Arc-enabled servers, then deploys the entraiddeviceidlinux Azure Machine Configuration assignment to read intuneDeviceId from /var/opt/microsoft/mdatp/wdavstate.",
    "metadata": {
      "category": "Guest Configuration",
      "requiredProviders": [
        "Microsoft.GuestConfiguration"
      ],
      "guestConfiguration": {
        "name": "entraiddeviceidlinux",
        "contentType": "Custom",
        "contentUri": "https://github.com/seanstark/defenderforservers-tools/raw/refs/heads/main/machineConfiguration/entraid-deviceid-linux/output/entraiddeviceidlinux.zip",
        "contentHash": "C879FA56AE7D70C164974AD90B2BD0117EDF7C42CB8BB5A2990EFE48FD03DCCE",
        "enableAutoRemediation": "[parameters('EnableAutoRemediation')]",
        "autoRemediationAssignmentType": "ApplyAndAutoCorrect",
        "version": "1.0.0"
      },
      "version": "1.0.0"
    },
    "parameters": {
      "EnableAutoRemediation": {
        "type": "string",
        "metadata": {
          "displayName": "Enable Auto Remediation",
          "description": "When true, the policy will automatically enforce remediation. When false, it will only audit",
          "portalReview": "true"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "tagName": {
        "type": "string",
        "metadata": {
          "displayName": "Optional Azure tag name",
          "description": "Name of the Azure resource tag used to filter machines. Leave blank to include all eligible Linux machines.",
          "portalReview": "true"
        },
        "defaultValue": ""
      },
      "tagValue": {
        "type": "string",
        "metadata": {
          "displayName": "Optional Azure tag value",
          "description": "Required value for the Azure resource tag. Used only when a tag name is provided.",
          "portalReview": "true"
        },
        "defaultValue": ""
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.HybridCompute/machines/extensions"
          },
          {
            "anyOf": [
              {
                "field": "name",
                "like": "*/MDE.Linux"
              },
              {
                "field": "Microsoft.HybridCompute/machines/extensions/type",
                "equals": "MDE.Linux"
              }
            ]
          },
          {
            "field": "Microsoft.HybridCompute/machines/extensions/provisioningState",
            "in": [
              "Succeeded",
              "Provisioning succeeded"
            ]
          },
          {
            "anyOf": [
              {
                "value": "[empty(parameters('tagName'))]",
                "equals": true
              },
              {
                "field": "[concat('tags[', parameters('tagName'), ']')]",
                "equals": "[parameters('tagValue')]"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "deployIfNotExists",
        "details": {
          "roleDefinitionIds": [
            "/providers/Microsoft.Authorization/roleDefinitions/088ab73d-1256-47ae-bea9-9de8e7131f31"
          ],
          "type": "Microsoft.GuestConfiguration/guestConfigurationAssignments",
          "name": "[concat('entraiddeviceidlinux$pid', uniqueString(policy().assignmentId, policy().definitionReferenceId))]",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.GuestConfiguration/guestConfigurationAssignments/complianceStatus",
                "equals": "Compliant"
              },
              {
                "value": "[parameters('EnableAutoRemediation')]",
                "in": [
                  "true",
                  "false"
                ]
              }
            ]
          },
          "deployment": {
            "properties": {
              "mode": "incremental",
              "parameters": {
                "vmName": {
                  "value": "[first(split(field('name'), '/'))]"
                },
                "location": {
                  "value": "[field('location')]"
                },
                "type": {
                  "value": "Microsoft.HybridCompute/machines"
                },
                "assignmentName": {
                  "value": "[concat('entraiddeviceidlinux$pid', uniqueString(policy().assignmentId, policy().definitionReferenceId))]"
                }
              },
              "template": {
                "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
                "contentVersion": "1.0.0.0",
                "parameters": {
                  "vmName": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "assignmentName": {
                    "type": "string"
                  }
                },
                "resources": [
                  {
                    "apiVersion": "2024-04-05",
                    "type": "Microsoft.HybridCompute/machines/providers/guestConfigurationAssignments",
                    "name": "[concat(parameters('vmName'), '/Microsoft.GuestConfiguration/', parameters('assignmentName'))]",
                    "location": "[parameters('location')]",
                    "properties": {
                      "guestConfiguration": {
                        "name": "entraiddeviceidlinux",
                        "contentType": "Custom",
                        "contentUri": "https://github.com/seanstark/defenderforservers-tools/raw/refs/heads/main/machineConfiguration/entraid-deviceid-linux/output/entraiddeviceidlinux.zip",
                        "contentHash": "C879FA56AE7D70C164974AD90B2BD0117EDF7C42CB8BB5A2990EFE48FD03DCCE",
                        "assignmentType": "Audit",
                        "version": "1.0.0"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "name": "d45b1c67-9e40-4f05-b083-6c24b7d5e0f9"
}
