{
        "mode": "Indexed",
        "metadata": {
            "category": "Guest Configuration",
            "version": "1.0.2",
            "requiredProviders": [
                "Microsoft.GuestConfiguration"
            ],
            "guestConfiguration": {
                "name": "MdeDefenderModeConfig",
                "version": "1.0.2",
                "contentType": "Custom",
                "contentUri": "https://github.com/seanstark/defenderforservers-tools/raw/refs/heads/main/machineConfiguration/mde-defender-mode/output/MdeDefenderModeConfig.zip",
                "contentHash": "D06FE773E0B1E11B6A0A2581B59269F301FBF9BDD8B539C61AB22C668ADE546F",
                "configurationParameter": {
                    "DefenderMode": "[MdeDefenderMode]DefenderForEndpointMode;Mode"
                },
                "enableAutoRemediation": "[parameters('EnableAutoRemediation')]",
                "autoRemediationAssignmentType": "ApplyAndAutoCorrect"
            }
        },
        "parameters": {
            "IncludeArcMachines": {
                "type": "string",
                "metadata": {
                    "displayName": "Include Arc connected machines",
                    "description": "By selecting this option, you agree to be charged monthly per Arc connected machine.",
                    "portalReview": "true"
                },
                "allowedValues": [
                    "true",
                    "false"
                ],
                "defaultValue": "true"
            },
            "EnableAutoRemediation": {
                "type": "string",
                "metadata": {
                    "displayName": "Enable Auto Remediation",
                    "description": "When true, the policy will automatically enforce remediation. When false, it will only audit",
                    "portalReview": "true"
                },
                "allowedValues": [
                    "true",
                    "false"
                ],
                "defaultValue": "true"
            },
            "contentUri": {
                "type": "string",
                "metadata": {
                    "displayName": "Machine Configuration package URI",
                    "description": "HTTPS URI for MdeDefenderModeConfig.zip. Any override must return the package matching the contentHash embedded in this policy definition.",
                    "portalReview": "true"
                },
                "defaultValue": "https://github.com/seanstark/defenderforservers-tools/raw/refs/heads/main/machineConfiguration/mde-defender-mode/output/MdeDefenderModeConfig.zip"
            },
            "DefenderMode": {
                "type": "string",
                "metadata": {
                    "displayName": "Defender for Endpoint mode",
                    "description": "Active writes ForceDefenderPassiveMode as DWORD 0. Passive writes it as DWORD 1.",
                    "portalReview": "true"
                },
                "defaultValue": "Passive",
                "allowedValues": [
                    "Active",
                    "Passive"
                ]
            }
        },
        "policyRule": {
            "if": {
                "anyOf": [
                    {
                        "allOf": [
                            {
                                "anyOf": [
                                    {
                                        "field": "type",
                                        "equals": "Microsoft.Compute/virtualMachines"
                                    },
                                    {
                                        "field": "type",
                                        "equals": "Microsoft.Compute/virtualMachineScaleSets"
                                    }
                                ]
                            },
                            {
                                "field": "tags['aks-managed-orchestrator']",
                                "exists": "false"
                            },
                            {
                                "field": "tags['aks-managed-poolName']",
                                "exists": "false"
                            },
                            {
                                "anyOf": [
                                    {
                                        "field": "Microsoft.Compute/imagePublisher",
                                        "in": [
                                            "esri",
                                            "incredibuild",
                                            "MicrosoftDynamicsAX",
                                            "MicrosoftSharepoint",
                                            "MicrosoftVisualStudio",
                                            "MicrosoftWindowsDesktop",
                                            "MicrosoftWindowsServerHPCPack"
                                        ]
                                    },
                                    {
                                        "allOf": [
                                            {
                                                "field": "Microsoft.Compute/imagePublisher",
                                                "equals": "MicrosoftWindowsServer"
                                            },
                                            {
                                                "field": "Microsoft.Compute/imageSKU",
                                                "notLike": "2008*"
                                            }
                                        ]
                                    },
                                    {
                                        "allOf": [
                                            {
                                                "field": "Microsoft.Compute/imagePublisher",
                                                "equals": "MicrosoftSQLServer"
                                            },
                                            {
                                                "field": "Microsoft.Compute/imageOffer",
                                                "notLike": "SQL2008*"
                                            }
                                        ]
                                    },
                                    {
                                        "allOf": [
                                            {
                                                "field": "Microsoft.Compute/imagePublisher",
                                                "equals": "microsoft-dsvm"
                                            },
                                            {
                                                "field": "Microsoft.Compute/imageOffer",
                                                "like": "dsvm-win*"
                                            }
                                        ]
                                    },
                                    {
                                        "allOf": [
                                            {
                                                "field": "Microsoft.Compute/imagePublisher",
                                                "equals": "microsoft-ads"
                                            },
                                            {
                                                "field": "Microsoft.Compute/imageOffer",
                                                "in": [
                                                    "standard-data-science-vm",
                                                    "windows-data-science-vm"
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "allOf": [
                                            {
                                                "field": "Microsoft.Compute/imagePublisher",
