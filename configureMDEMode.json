                                                "contentHash": "D06FE773E0B1E11B6A0A2581B59269F301FBF9BDD8B539C61AB22C668ADE546F",
                                                "assignmentType": "ApplyAndAutoCorrect",
                                                "configurationParameter": [
                                                    {
                                                        "name": "[MdeDefenderMode]DefenderForEndpointMode;Mode",
                                                        "value": "[parameters('DefenderMode')]"
