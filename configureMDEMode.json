                                    },
                                    "DefenderMode": {
                                        "type": "string"
                                    },
                                    "contentUri": {
                                        "type": "string"
                                    }
                                },
                                "resources": [
                                    {
                                        "condition": "[equals(toLower(parameters('type')), toLower('Microsoft.Compute/virtualMachines'))]",
                                        "apiVersion": "2024-04-05",
                                        "type": "Microsoft.Compute/virtualMachines/providers/guestConfigurationAssignments",
                                        "name": "[concat(parameters('vmName'), '/Microsoft.GuestConfiguration/', parameters('assignmentName'))]",
                                        "location": "[parameters('location')]",
                                        "properties": {
                                            "guestConfiguration": {
                                                "name": "MdeDefenderModeConfig",
                                                "version": "1.0.2",
                                                "contentType": "Custom",
                                                "contentUri": "[parameters('contentUri')]",
                                                "contentHash": "D06FE773E0B1E11B6A0A2581B59269F301FBF9BDD8B539C61AB22C668ADE546F",
                                                "assignmentType": "ApplyAndAutoCorrect",
                                                "configurationParameter": [
                                                    {
                                                        "name": "[MdeDefenderMode]DefenderForEndpointMode;Mode",
                                                        "value": "[parameters('DefenderMode')]"
                                                    }
                                                ]
                                            }
                                        }
                                    },
                                    {
                                        "condition": "[equals(toLower(parameters('type')), toLower('Microsoft.HybridCompute/machines'))]",
                                        "apiVersion": "2024-04-05",
                                        "type": "Microsoft.HybridCompute/machines/providers/guestConfigurationAssignments",
                                        "name": "[concat(parameters('vmName'), '/Microsoft.GuestConfiguration/', parameters('assignmentName'))]",
                                        "location": "[parameters('location')]",
                                        "properties": {
                                            "guestConfiguration": {
                                                "name": "MdeDefenderModeConfig",
                                                "version": "1.0.2",
