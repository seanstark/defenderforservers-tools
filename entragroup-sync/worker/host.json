{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Function": "Information",
      "Host.Results": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Trace;Exception;Request;Dependency"
      }
    }
  },
  "extensions": {
    "serviceBus": {
      "prefetchCount": 16,
      "maxConcurrentCalls": 8,
      "maxAutoLockRenewalDuration": "00:10:00"
    }
  }
}
