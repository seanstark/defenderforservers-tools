              "clientId": "[parameters('reportClientId')]",
              "clientSecretSettingName": "MICROSOFT_PROVIDER_AUTHENTICATION_SECRET",
              "openIdIssuer": "[format('{0}{1}/v2.0', environment().authentication.loginEndpoint, parameters('tenantId'))]"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('reportClientId')]",
                "[format('api://{0}', parameters('reportClientId'))]"
              ]
            }
          }
        },
        "login": {
          "tokenStore": {
            "enabled": true
          }
        },
        "httpSettings": {
          "requireHttps": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', if(equals(1, 0), variables('workerName'), variables('reportName')))]"
      ]
    },
    {
      "copy": {
        "name": "basicAuth",
        "count": "[length(createArray('worker', 'report'))]"
      },
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', if(equals(copyIndex(), 0), variables('workerName'), variables('reportName')), 'scm')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', if(equals(copyIndex(), 0), variables('workerName'), variables('reportName')))]"
      ]
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('{0}-dead-letters', parameters('namePrefix'))]",
      "location": "global",
      "properties": {
        "copy": [
          {
            "name": "actions",
            "count": "[length(parameters('alertActionGroupIds'))]",
            "input": {
              "actionGroupId": "[parameters('alertActionGroupIds')[copyIndex('actions')]]"
            }
          }
        ],
        "description": "Arc-to-Entra work is dead-lettered. Inspect the machines queue and worker logs before replaying.",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[resourceId('Microsoft.ServiceBus/namespaces', format('{0}-bus-{1}', parameters('namePrefix'), take(variables('suffix'), 6)))]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "DeadLetters",
              "metricNamespace": "Microsoft.ServiceBus/namespaces",
              "metricName": "DeadletteredMessages",
              "operator": "GreaterThan",
              "threshold": 0,
              "timeAggregation": "Maximum",
              "dimensions": [
                {
                  "name": "EntityName",
                  "operator": "Include",
                  "values": [
                    "machines"
                  ]
                }
              ],
              "criterionType": "StaticThresholdCriterion"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces', format('{0}-bus-{1}', parameters('namePrefix'), take(variables('suffix'), 6)))]"
      ]
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-inventory-stale', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "kind": "LogAlert",
      "properties": {
        "displayName": "Arc-to-Entra inventory has not completed in 90 minutes",
        "description": "Adjust the query threshold if changing the default 30-minute schedule.",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT15M",
        "windowSize": "P2D",
        "scopes": [
          "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix')))]"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "[format('AppTraces | where AppRoleName == \"{0}\" and Message startswith \"INFORMATION: Inventory completed:\" or AppRoleName == \"{1}\" and Message startswith \"Inventory completed:\" | summarize LastSuccess = max(TimeGenerated) | where isnull(LastSuccess) or LastSuccess < ago(90m)', variables('workerName'), variables('workerName'))]",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": "[parameters('alertActionGroupIds')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('namePrefix')))]"
      ]
    }
  ],
  "outputs": {
    "workerAppName": {
      "type": "string",
      "value": "[if(equals(0, 0), variables('workerName'), variables('reportName'))]"
    },
    "workerPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', if(equals(0, 0), variables('workerName'), variables('reportName'))), '2023-12-01', 'full').identity.principalId]"
    },
    "workerFunctionId": {
      "type": "string",
      "value": "[format('{0}/functions/ArcEvent', resourceId('Microsoft.Web/sites', if(equals(0, 0), variables('workerName'), variables('reportName'))))]"
    },
    "reportAppName": {
      "type": "string",
      "value": "[if(equals(1, 0), variables('workerName'), variables('reportName'))]"
    },
    "reportUrl": {
      "type": "string",
      "value": "[format('https://{0}/', reference(resourceId('Microsoft.Web/sites', if(equals(1, 0), variables('workerName'), variables('reportName'))), '2023-12-01').defaultHostName)]"
    },
    "reportRedirectUri": {
      "type": "string",
      "value": "[format('https://{0}/.auth/login/aad/callback', reference(resourceId('Microsoft.Web/sites', if(equals(1, 0), variables('workerName'), variables('reportName'))), '2023-12-01').defaultHostName)]"
    },
    "dataStorageAccount": {
      "type": "string",
      "value": "[format('sync{0}', variables('suffix'))]"
    },
    "serviceBusNamespace": {
      "type": "string",
      "value": "[format('{0}-bus-{1}', parameters('namePrefix'), take(variables('suffix'), 6))]"
    }
  }
}