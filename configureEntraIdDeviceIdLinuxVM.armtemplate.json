{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Checks MDE.Linux provisioning on native Azure Linux virtual machines, then deploys an Audit assignment that reads intuneDeviceId from wdavstate with a newest-enrollment SenseCM log fallback."
  },
  "parameters": {
    "policyDefinitionName": {
      "type": "string",
      "defaultValue": "audit-mde-entraid-deviceid-linux-machines",
      "metadata": {
        "description": "Name of the custom Azure Policy definition."
      }
    },
    "policyDefinitionDisplayName": {
      "type": "string",
      "defaultValue": "Audit MDE Entra ID Device ID on Linux machines",
      "metadata": {
        "description": "Display name of the custom Azure Policy definition."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2023-04-01",
      "name": "[parameters('policyDefinitionName')]",
      "properties": {
        "policyType": "Custom",
        "mode": "Indexed",
        "displayName": "[parameters('policyDefinitionDisplayName')]",
        "description": "Checks MDE.Linux provisioning on native Azure Linux virtual machines, then deploys an Audit assignment that reads intuneDeviceId from wdavstate with a newest-enrollment SenseCM log fallback.",
        "metadata": {
          "category": "Guest Configuration",
          "requiredProviders": [
            "Microsoft.GuestConfiguration"
          ],
          "guestConfiguration": {
            "name": "entraiddeviceidlinux",
            "contentType": "Custom",
            "contentUri": "https://raw.githubusercontent.com/seanstark/defenderforservers-tools/770e079d38e3da51e68eff0afb33070df22e9305/machineConfiguration/entraid-deviceid-linux/output/entraiddeviceidlinux.zip",
            "contentHash": "955BCE70E95EFF23F84D11D5EC3C27439DEDE01F891C4C9A241E833FFAD2681E",
            "version": "1.0.1"
          },
          "version": "1.0.1"
        },
        "parameters": {
          "tagName": {
            "type": "string",
            "metadata": {
              "displayName": "Optional Azure tag name",
              "description": "Name of the Azure resource tag used to filter machines. Leave blank to include all eligible Linux machines.",
              "portalReview": "true"
            },
            "defaultValue": ""
          },
          "tagValue": {
            "type": "string",
            "metadata": {
              "displayName": "Optional Azure tag value",
              "description": "Required value for the Azure resource tag. Used only when a tag name is provided.",
              "portalReview": "true"
            },
            "defaultValue": ""
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Compute/virtualMachines/extensions"
              },
              {
                "anyOf": [
                  {
                    "field": "name",
                    "like": "*/MDE.Linux"
                  },
                  {
                    "field": "Microsoft.Compute/virtualMachines/extensions/type",
                    "equals": "MDE.Linux"
                  }
                ]
              },
              {
                "field": "Microsoft.Compute/virtualMachines/extensions/provisioningState",
                "in": [
                  "Succeeded",
                  "Provisioning succeeded"
                ]
              },
              {
                "anyOf": [
                  {
                    "value": "[[empty(parameters('tagName'))]",
                    "equals": true
                  },
                  {
                    "field": "[[concat('tags[', parameters('tagName'), ']')]",
                    "equals": "[[parameters('tagValue')]"
                  }
                ]
              }
            ]
          },
          "then": {
            "effect": "deployIfNotExists",
            "details": {
              "roleDefinitionIds": "[createArray('/providers/Microsoft.Authorization/roleDefinitions/088ab73d-1256-47ae-bea9-9de8e7131f31')]",
              "type": "Microsoft.GuestConfiguration/guestConfigurationAssignments",
              "name": "[[concat('entraiddeviceidlinux$pid', uniqueString(policy().assignmentId, policy().definitionReferenceId))]",
              "existenceCondition": {
                "field": "Microsoft.GuestConfiguration/guestConfigurationAssignments/complianceStatus",
                "equals": "Compliant"
              },
              "deployment": {
                "properties": {
                  "mode": "incremental",
                  "parameters": {
                    "vmName": {
                      "value": "[[first(split(field('name'), '/'))]"
                    },
                    "location": {
                      "value": "[[field('location')]"
                    },
                    "type": {
                      "value": "Microsoft.Compute/virtualMachines"
                    },
                    "assignmentName": {
                      "value": "[[concat('entraiddeviceidlinux$pid', uniqueString(policy().assignmentId, policy().definitionReferenceId))]"
                    }
                  },
                  "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                      "vmName": {
                        "type": "string"
                      },
                      "location": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "assignmentName": {
                        "type": "string"
                      }
                    },
                    "resources": [
                      {
                        "apiVersion": "2024-04-05",
                        "type": "Microsoft.Compute/virtualMachines/providers/guestConfigurationAssignments",
                        "name": "[[concat(parameters('vmName'), '/Microsoft.GuestConfiguration/', parameters('assignmentName'))]",
                        "location": "[[parameters('location')]",
                        "properties": {
                          "guestConfiguration": {
                            "name": "entraiddeviceidlinux",
                            "contentType": "Custom",
                            "contentUri": "https://raw.githubusercontent.com/seanstark/defenderforservers-tools/770e079d38e3da51e68eff0afb33070df22e9305/machineConfiguration/entraid-deviceid-linux/output/entraiddeviceidlinux.zip",
                            "contentHash": "955BCE70E95EFF23F84D11D5EC3C27439DEDE01F891C4C9A241E833FFAD2681E",
                            "assignmentType": "Audit",
                            "version": "1.0.1"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "version": "1.0.1"
      }
    }
  ]
}
